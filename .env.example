# TryOnX 2.0 Environment Variables
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control

# Supabase
VITE_SUPABASE_URL=https://cvnjolehwzubdusrmawm.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Razorpay (Test Mode)
# Get from https://dashboard.razorpay.com/app/website-app-settings/api-keys
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx

# FASHN AI Virtual Try-On
# Get from https://fashn.ai/
# NOTE: This key must ONLY be used server-side (Supabase Edge Functions)
# Do NOT prefix with VITE_ — never expose to browser
FASHN_API_KEY=your_fashn_api_key_here

# Admin
# The admin email used to seed the first admin user
VITE_ADMIN_EMAIL=admin@tryonx.in

# App
VITE_APP_URL=http://localhost:5173
VITE_APP_NAME=TryOnX

# Email (optional - for order notifications)
# VITE_RESEND_API_KEY=re_xxxxxxxxx

# Hugging Face Access Token (optional - grants high ZeroGPU quota for IDM-VTON neural try-on)
# Get a free read token from: https://huggingface.co/settings/tokens
VITE_HF_TOKEN=
HF_TOKEN=
